@startuml

actor Client
participant "app.js" as App
participant "router.js" as Router

participant "pizzas.js" as PizzasRoute
participant "pizzaController.js" as PizzaController
participant "Pizza.js" as PizzaEntity

participant "ingredients.js" as IngredientsRoute
participant "ingredientController.js" as IngredientController
participant "Ingredient.js" as IngredientEntity

database "SQLite" as DB

== Création d'une pizza ==

Client -> App : POST /api/v1/pizzas
App -> Router : Transmet la requête
Router -> PizzasRoute : Route /pizzas

PizzasRoute -> PizzaController : create(req, res, next)
PizzaController -> PizzaEntity : create(name, description, imageUrl, price)

PizzaEntity -> DB : INSERT INTO pizzas (...)
DB --> PizzaEntity : Pizza créée

PizzaEntity --> PizzaController : Pizza créée
PizzaController --> Client : 201 Created + JSON

== Création d'un ingrédient ==

Client -> App : POST /api/v1/ingredients
App -> Router : Transmet la requête
Router -> IngredientsRoute : Route /ingredients

IngredientsRoute -> IngredientController : create(req, res, next)
IngredientController -> IngredientEntity : create(name, price)

IngredientEntity -> DB : INSERT INTO ingredients (...)
DB --> IngredientEntity : Ingrédient créé

IngredientEntity --> IngredientController : Ingrédient créé
IngredientController --> Client : 201 Created + JSON

@enduml